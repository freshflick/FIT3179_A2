{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Publisher shares of 2022–2026 Prime Minister’s Literary Awards records with named publishers and Stella longlists.",
  "data": {
    "url": "data/publisher_award_comparison.csv"
  },
  "width": "container",
  "height": 340,
  "transform": [
    {
      "calculate": "datum.pmla_books / 144",
      "as": "pmla_share"
    },
    {
      "calculate": "datum.stella_books / 60",
      "as": "stella_share"
    },
    {
      "calculate": "abs(datum.pmla_books * 60 - datum.stella_books * 144)",
      "as": "share_gap_order"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "difference_rank"
        }
      ],
      "sort": [
        {
          "field": "share_gap_order",
          "order": "descending"
        },
        {
          "field": "publisher_key",
          "order": "ascending"
        }
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "publisher_key",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "difference_rank",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "labelLimit": 330,
        "tickSize": 0,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#aebbc0",
        "strokeWidth": 2.4
      },
      "encoding": {
        "x": {
          "field": "pmla_share",
          "type": "quantitative",
          "title": "Share of books on each award list",
          "scale": {
            "domain": [
              -0.015,
              0.17
            ],
            "zero": false
          },
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.05,
              0.1,
              0.15
            ],
            "grid": true,
            "gridColor": "#e8ecee",
            "tickSize": 0
          }
        },
        "x2": {
          "field": "stella_share"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "pmla_share",
            "stella_share"
          ],
          "as": [
            "award_key",
            "share"
          ]
        },
        {
          "calculate": "datum.award_key === 'pmla_share' ? 'Prime Minister’s Literary Awards' : 'Stella Prize'",
          "as": "award"
        },
        {
          "calculate": "datum.award_key === 'pmla_share' ? datum.pmla_books : datum.stella_books",
          "as": "award_books"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 145,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of books on each award list",
          "scale": {
            "domain": [
              -0.015,
              0.17
            ],
            "zero": false
          },
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.05,
              0.1,
              0.15
            ],
            "grid": true,
            "gridColor": "#e8ecee",
            "tickSize": 0
          }
        },
        "color": {
          "field": "award",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Prime Minister’s Literary Awards",
              "Stella Prize"
            ],
            "range": [
              "#ad6d37",
              "#7565a3"
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "publisher_key",
            "type": "nominal",
            "title": "Publisher"
          },
          {
            "field": "award",
            "type": "nominal",
            "title": "Award"
          },
          {
            "field": "award_books",
            "type": "quantitative",
            "title": "Books"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of list",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.publisher_key == 'Allen & Unwin' || datum.publisher_key == 'Giramondo Publishing'"
        },
        {
          "calculate": "(datum.pmla_share + datum.stella_share) / 2",
          "as": "gap_midpoint"
        },
        {
          "calculate": "format(abs(datum.pmla_share - datum.stella_share) * 100, '.1f') + ' percentage points'",
          "as": "gap_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -13,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#233441"
      },
      "encoding": {
        "x": {
          "field": "gap_midpoint",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.015,
              0.17
            ],
            "zero": false
          }
        },
        "text": {
          "field": "gap_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#3c4c56",
      "titleColor": "#233441",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "labelColor": "#3c4c56",
      "labelFontSize": 11,
      "symbolSize": 85
    }
  }
}
