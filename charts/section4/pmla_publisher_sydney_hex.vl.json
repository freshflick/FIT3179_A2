{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distinct publishers of 2022\u20132026 PMLA-listed books in occupied 2 km equal-area cells around Sydney. Locations are sourced publisher-contact locality centroids.",
  "width": "container",
  "height": 340,
  "background": "#ffffff",
  "projection": {
    "type": "mercator",
    "center": [
      151.12,
      -33.87
    ],
    "scale": 70000
  },
  "layer": [
    {
      "data": {
        "url": "data/abs_sydney_suburbs_2021.geojson?v=2",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f0e9",
        "stroke": "#b8c8ce",
        "strokeWidth": 0.62,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "extent": [
            [
              150.8,
              -34.05
            ],
            [
              151.4,
              -33.65
            ]
          ],
          "step": [
            0.1,
            0.1
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#c6d8de",
        "strokeWidth": 0.65,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/pmla_publisher_contact_hex_bins.geojson?v=4",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.metro_areas",
          "as": "metro"
        },
        {
          "calculate": "datum.properties.publishers",
          "as": "publishers"
        },
        {
          "calculate": "datum.properties.listed_books",
          "as": "listed_books"
        },
        {
          "calculate": "datum.properties.winning_books",
          "as": "winning_books"
        },
        {
          "filter": "datum.metro == 'Sydney'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.3,
        "opacity": 0.96,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "publishers",
          "type": "ordinal",
          "legend": null,
          "scale": {
            "domain": [
              1,
              2,
              3,
              4
            ],
            "range": [
              "#b5d9c7",
              "#7dbda2",
              "#3e9878",
              "#0f6652"
            ]
          }
        },
        "tooltip": [
          {
            "field": "metro",
            "type": "nominal",
            "title": "Contact metro"
          },
          {
            "field": "publishers",
            "type": "quantitative",
            "title": "Publishers"
          },
          {
            "field": "listed_books",
            "type": "quantitative",
            "title": "Listed books"
          },
          {
            "field": "winning_books",
            "type": "quantitative",
            "title": "Winners"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#e7f2f6"
    }
  }
}
