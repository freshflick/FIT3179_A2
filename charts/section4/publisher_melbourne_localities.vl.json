                ],
                [
                  145.1,
                  -37.6
                ]
              ]
            },
            "properties": {}
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  145.2,
                  -38.08
                ],
                [
                  145.2,
                  -37.6
                ]
              ]
            },
            "properties": {}
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  144.7,
                  -38.0
                ],
                [
                  145.3,
                  -38.0
                ]
              ]
            },
            "properties": {}
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  144.7,
                  -37.9
                ],
                [
                  145.3,
                  -37.9
                ]
              ]
            },
            "properties": {}
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  144.7,
                  -37.8
                ],
                [
                  145.3,
                  -37.8
                ]
              ]
            },
            "properties": {}
          },
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  144.7,
                  -37.7
                ],
                [
                  145.3,
                  -37.7
                ]
              ]
            },
            "properties": {}
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#bdd3da",
        "strokeWidth": 0.55,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/publisher_contact_locality_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.map_city == 'Melbourne'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#286f91",
            "opacity": 0.86,
            "stroke": "#ffffff",
            "strokeWidth": 1.7,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Listed books",
              "scale": {
                "domain": [
                  0,
                  22
                ],
                "range": [
                  55,
                  1600
                ]
              },
              "legend": {
                "orient": "bottom",
                "values": [
                  1,
                  10,
                  20
                ],
                "symbolFillColor": "#286f91"
              }
            },
            "tooltip": [
              {
                "field": "contact_locality",
                "type": "nominal",
                "title": "Contact locality"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {
                "field": "winning_books",
                "type": "quantitative",
                "title": "Winners"
              },
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Publishers"
              },
              {
                "field": "publisher_names",
                "type": "nominal",
                "title": "Publisher names"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "indexof(['Collingwood', 'Southbank'], datum.contact_locality) >= 0"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -17,
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#213b48",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "contact_locality",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": "#d9edf4"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
