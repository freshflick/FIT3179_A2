    },
    {
      "data": {
        "url": "data/publisher_contact_locality_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.map_city == 'Melbourne'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#286f91",
            "opacity": 0.78,
            "stroke": "#ffffff",
            "strokeWidth": 1.8
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Listed books",
              "scale": {
                "domain": [
                  0,
                  22
                ],
                "range": [
                  45,
                  1800
                ]
              },
              "legend": {
                "orient": "bottom",
                "values": [
                  1,
                  10,
                  20
                ],
                "symbolFillColor": "#286f91"
              }
            },
            "tooltip": [
              {
                "field": "contact_locality",
                "type": "nominal",
                "title": "Contact locality"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Publishers"
              },
              {
                "field": "publisher_names",
                "type": "nominal",
                "title": "Publisher names"
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
