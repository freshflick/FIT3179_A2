{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Documented publisher-contact localities around Melbourne for PMLA-listed books, 2022\u20132026. ABS 2021 suburb polygons provide geographic context; circle area shows listed-book records.",
  "width": "container",
  "height": 400,
  "background": "#ffffff",
  "projection": {
    "type": "mercator",
    "center": [
      144.99,
      -37.84
    ],
    "scale": 70000
  },
  "layer": [
    {
      "data": {
        "url": "data/abs_melbourne_suburbs_2021.geojson?v=2",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1ede4",
        "stroke": "#d7ddd9",
        "strokeWidth": 0.32,
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  144.8,
