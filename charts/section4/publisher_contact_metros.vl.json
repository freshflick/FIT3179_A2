{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Eight metro reference points for documented publisher contact localities covering 86 of 90 listed books in the 2024–2026 Prime Minister's Literary Awards. Circle area represents listed books.",
  "width": "container",
  "height": 430,
  "background": "#ffffff",
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {"url": "data/abs_states_2021.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {
        "type": "geoshape",
        "fill": "#E8EEF1",
        "stroke": "#C4D3D8",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {"url": "data/publisher_contact_city_summary.csv"},
      "transform": [
        {"calculate": "datum.map_city + ' · ' + datum.listed_books", "as": "map_label"}
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#286f91",
            "opacity": 0.84,
            "stroke": "#ffffff",
            "strokeWidth": 1.7,
            "size": 100
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Listed books",
              "scale": {"domain": [0, 45], "range": [90, 2700]},
              "legend": {"orient": "bottom", "values": [1, 10, 25, 45]}
            },
            "tooltip": [
              {
                "field": "map_city",
                "type": "nominal",
                "title": "Publisher contact metro"
              },
              {
                "field": "state",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {"field": "winning_books", "type": "quantitative", "title": "Winning books"},
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Publishers"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -19,
            "dx": -12,
            "align": "right",
            "font": "Arial",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#233441"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "map_label",
              "type": "nominal"
            }
          },
          "transform": [{"filter": "datum.listed_books >= 3 && datum.map_city != 'Broome'"}]
        },
        {
          "transform": [{"filter": "datum.map_city == 'Broome'"}],
          "mark": {"type": "text", "dy": -17, "dx": 11, "align": "left", "font": "Arial", "fontSize": 13, "fontWeight": "bold", "color": "#233441"},
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "map_label", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
