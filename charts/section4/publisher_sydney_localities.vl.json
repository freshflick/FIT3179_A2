{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Publisher-contact localities around Sydney for Prime Minister's Literary Awards shortlist records, 2022\u20132026. Circle area shows listed books; copper color shows winner share.",
  "width": "container",
  "height": 340,
  "background": "white",
  "params": [
    {
      "name": "sydney_zoom",
      "value": 1
    },
    {
      "name": "sydney_pan_x",
      "value": 0
    },
    {
      "name": "sydney_pan_y",
      "value": 0
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [
      151.02,
      -33.845
    ],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [
            150.65,
            -34.12
          ],
          [
            151.39,
            -33.57
          ]
        ]
      }
    },
    "extent": {
      "expr": "[[width / 2 + sydney_pan_x - (width - 20) * sydney_zoom / 2, height / 2 + sydney_pan_y - (height - 20) * sydney_zoom / 2], [width / 2 + sydney_pan_x + (width - 20) * sydney_zoom / 2, height / 2 + sydney_pan_y + (height - 20) * sydney_zoom / 2]]"
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EAF3F8",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/abs_sydney_suburbs_2021.geojson?v=3",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F4F3EF",
        "stroke": "#92A6AE",
        "strokeWidth": 0.45,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            0.2,
            0.2
          ],
          "extent": [
            [
              149.65,
              -35.12
            ],
            [
              152.39,
              -32.57
            ]
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#B9D1DE",
        "strokeWidth": 0.4,
        "opacity": 0.35,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/publisher_contact_locality_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.map_city === 'Sydney'"
        },
        {
          "calculate": "datum.winning_books / datum.listed_books * 100",
          "as": "winner_share_pct"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "listed_books",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "listed_books",
          "type": "quantitative",
          "title": "Listed books",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              22
            ],
            "range": [
              12,
              850
            ],
            "zero": true
          },
          "legend": {
            "orient": "bottom",
            "values": [
              1,
              10,
              20
            ],
            "symbolFillColor": "white",
            "symbolStrokeColor": "#74300B",
            "symbolStrokeWidth": 1.5
          }
        },
        "color": {
          "field": "winner_share_pct",
          "type": "quantitative",
          "title": "Winner share (%)",
          "scale": {
            "domain": [
              0,
              20,
              40
            ],
            "range": [
              "#E8BB82",
              "#BB7330",
              "#74300B"
            ],
            "interpolate": "lab",
            "clamp": true
          },
          "legend": {
            "gradientLength": 190,
            "gradientThickness": 10,
            "values": [
              0,
              20,
              40
            ],
            "format": ".0f",
            "titleOrient": "top",
            "titleAnchor": "start"
          }
        },
        "tooltip": [
          {
            "field": "map_city",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "contact_locality",
            "type": "nominal",
            "title": "Area"
          },
          {
            "field": "listed_books",
            "type": "quantitative",
            "title": "Listed books",
            "format": ","
          },
          {
            "field": "winning_books",
            "type": "quantitative",
            "title": "Winners"
          },
          {
            "field": "winner_share_pct",
            "type": "quantitative",
            "title": "Winner share",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "title": {
      "font": "Georgia",
      "subtitleFont": "Arial"
    },
    "view": {
      "stroke": "#C7D6DE",
      "strokeWidth": 0.7
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "orient": "bottom"
    }
  }
}
