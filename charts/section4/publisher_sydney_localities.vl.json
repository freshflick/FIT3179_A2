{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Documented publisher-contact localities around Sydney for PMLA-listed books, 2022\u20132026. ABS 2021 suburb polygons provide geographic context; circle area shows listed-book records.",
  "width": "container",
  "height": 400,
  "background": "#dceef4",
  "projection": {
    "type": "mercator",
    "center": [
      151.12,
      -33.87
    ],
    "scale": 70000
  },
  "layer": [
    {
      "data": {
        "url": "data/abs_sydney_suburbs_2021.geojson?v=2",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2eee5",
        "stroke": null,
        "clip": true
      }
    },
