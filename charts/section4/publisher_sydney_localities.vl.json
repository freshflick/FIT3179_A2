          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#d2dfe1",
        "strokeWidth": 0.55,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/publisher_contact_locality_summary.csv"
      },
      "transform": [
        {
          "filter": "datum.map_city == 'Sydney'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#286f91",
            "opacity": 0.86,
            "stroke": "#ffffff",
            "strokeWidth": 1.7,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Listed books",
              "scale": {
                "domain": [
                  0,
                  22
                ],
                "range": [
                  55,
                  1600
                ]
              },
              "legend": {
                "orient": "bottom",
                "values": [
                  1,
                  10,
                  20
                ],
                "symbolFillColor": "#286f91"
              }
            },
            "tooltip": [
              {
                "field": "contact_locality",
                "type": "nominal",
                "title": "Contact locality"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {
                "field": "winning_books",
                "type": "quantitative",
                "title": "Winners"
              },
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Publishers"
              },
              {
                "field": "publisher_names",
                "type": "nominal",
                "title": "Publisher names"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "indexof(['Crows Nest', 'Parramatta'], datum.contact_locality) >= 0"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -17,
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#213b48",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "contact_locality",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
