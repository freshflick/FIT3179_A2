{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian Bureau of Statistics 2021 state boundaries shaded by winner share among publisher-attributed Prime Minister’s Literary Awards records associated with documented publisher contact states, 2022–2026; all 30 winners are included.",
  "width": "container",
  "height": 430,
  "background": "#ffffff",
  "params": [
    {"name": "map_zoom", "value": 1},
    {"name": "map_pan_x", "value": 0},
    {"name": "map_pan_y", "value": 0}
  ],
  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "fit": {"type": "Feature", "properties": {}, "geometry": {"type": "MultiPoint", "coordinates": [[112, -45], [155, -9]]}},
    "extent": {"expr": "[[width / 2 + map_pan_x - (width - 20) * map_zoom / 2, height / 2 + map_pan_y - (height - 20) * map_zoom / 2], [width / 2 + map_pan_x + (width - 20) * map_zoom / 2, height / 2 + map_pan_y + (height - 20) * map_zoom / 2]]"},
    "clipExtent": {"expr": "[[0, 0], [width, height]]"}
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#EAF3F8", "stroke": null, "clip": true}
    },
    {
      "data": {"url": "data/abs_states_2021.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {"url": "data/publisher_contact_state_summary.csv"},
            "key": "state_name",
            "fields": ["listed_books", "winning_books", "winner_share_pct"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.1, "clip": true},
      "encoding": {
        "color": {
          "field": "winner_share_pct", "type": "quantitative", "title": "Winner share (%)",
          "scale": {"domain": [0, 20, 40], "range": ["#F8E8EF", "#CB7FA1", "#78334F"], "clamp": true, "unknown": "#e8eceb"},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 220, "tickCount": 5}
        },
        "tooltip": [
          {"field": "properties.state", "type": "nominal", "title": "Publisher contact state"},
          {"field": "winning_books", "type": "quantitative", "title": "Winning books"},
          {"field": "listed_books", "type": "quantitative", "title": "Listed books"},
          {"field": "winner_share_pct", "type": "quantitative", "title": "Winner share (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"graticule": {"extent": [[112, -45], [155, -9]], "step": [10, 10]}},
      "mark": {"type": "geoshape", "fill": null, "stroke": "#B9D1DE", "strokeWidth": 0.4, "opacity": 0.35, "clip": true}
    },
    {
      "data": {"values": [
        {"longitude": 120, "latitude": -9.5, "label": "120°E"},
        {"longitude": 130, "latitude": -9.5, "label": "130°E"},
        {"longitude": 140, "latitude": -9.5, "label": "140°E"},
        {"longitude": 150, "latitude": -9.5, "label": "150°E"}
      ]},
      "mark": {"type": "text", "font": "Arial", "fontSize": 11, "color": "#526c75", "clip": true, "baseline": "bottom", "dy": -3},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {"values": [
        {"longitude": 113.8, "latitude": -20, "label": "20°S"},
        {"longitude": 113.8, "latitude": -30, "label": "30°S"},
        {"longitude": 113.8, "latitude": -40, "label": "40°S"}
      ]},
      "mark": {"type": "text", "font": "Arial", "fontSize": 11, "color": "#526c75", "align": "right", "dx": -5, "clip": true},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    },
    {
      "data": {"values": [
        {"state": "WA", "state_name": "Western Australia", "longitude": 121.5, "latitude": -26},
        {"state": "QLD", "state_name": "Queensland", "longitude": 143.5, "latitude": -21},
        {"state": "NSW", "state_name": "New South Wales", "longitude": 147, "latitude": -32},
        {"state": "VIC", "state_name": "Victoria", "longitude": 145, "latitude": -36.6}
      ]},
      "transform": [
        {"lookup": "state", "from": {"data": {"url": "data/publisher_contact_state_summary.csv"}, "key": "state", "fields": ["winner_share_pct"]}},
        {"calculate": "datum.state_name + '  ' + format(datum.winner_share_pct, '.1f') + '%'", "as": "label"}
      ],
      "mark": {"type": "text", "font": "Arial", "fontSize": 10, "fontWeight": "bold", "align": "center", "baseline": "middle", "clip": true},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"},
        "color": {"value": "#ffffff"}
      }
    }
  ],
  "config": {"view": {"stroke": "#C7D6DE", "strokeWidth": 0.7, "fill": "white"}, "legend": {"labelFont": "Arial", "titleFont": "Arial"}}
}
