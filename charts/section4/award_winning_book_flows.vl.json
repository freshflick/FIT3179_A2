    "type": "equirectangular",
    "rotate": [
      -150,
      0,
      0
    ],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [
          [
            -29.99,
            75
          ],
          [
            -29.99,
            -55
          ],
          [
            -30.01,
            75
          ],
          [
            -30.01,
            -55
          ]
        ]
      }
    },
    "clipExtent": {
      "expr": "[[0, 0], [width, height]]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
