        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) !== 10"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#EBE8E1",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.55,
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  -180,
                  0
                ],
                [
                  180,
                  0
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#8A9BAA",
        "strokeWidth": 0.8,
        "strokeDash": [
          4,
          4
        ],
        "clip": true
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 0,
            "latitude": -49,
            "label": "0°"
          },
          {
            "longitude": -24,
            "latitude": 30,
            "label": "30°N"
          },
          {
            "longitude": -24,
            "latitude": 0,
            "label": "0°"
          },
          {
            "longitude": -24,
            "latitude": -30,
            "label": "30°S"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9,
        "color": "#7A8C98",
        "align": "left",
        "dx": 3
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/award_winning_book_edition_markets.csv?v=14",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "title_count": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.kind === 'market'"
        },
        {
          "calculate": "datum.place",
          "as": "destination_market"
        },
        {
          "calculate": "datum.longitude < -30 ? datum.longitude + 360 : datum.longitude",
          "as": "end_lon"
        },
        {
          "calculate": "133.7751",
          "as": "start_lon"
        },
        {
          "calculate": "-25.2744",
          "as": "start_lat"
        },
        {
          "calculate": "datum.end_lon - datum.start_lon",
          "as": "dx"
        },
        {
          "calculate": "datum.latitude - datum.start_lat",
          "as": "dy"
        },
        {
          "calculate": "sqrt(pow(datum.dx, 2) + pow(datum.dy, 2)) * 0.08 < 7 ? 7 : sqrt(pow(datum.dx, 2) + pow(datum.dy, 2)) * 0.08",
          "as": "route_bow"
        },
        {
          "calculate": "datum.start_lon + datum.dx / 3",
          "as": "c1_lon"
        },
        {
          "calculate": "datum.start_lat + datum.dy / 3 + datum.route_bow",
          "as": "c1_lat"
        },
        {
          "calculate": "datum.start_lon + 2 * datum.dx / 3",
          "as": "c2_lon"
        },
        {
          "calculate": "datum.start_lat + 2 * datum.dy / 3 + datum.route_bow",
          "as": "c2_lat"
        },
        {
          "calculate": "sequence(0, 41, 1)",
          "as": "steps"
        },
        {
          "flatten": [
            "steps"
          ],
          "as": [
            "step"
          ]
        },
        {
          "calculate": "datum.step / 40",
          "as": "t"
        },
        {
          "calculate": "pow(1 - datum.t, 3) * datum.start_lon + 3 * pow(1 - datum.t, 2) * datum.t * datum.c1_lon + 3 * (1 - datum.t) * pow(datum.t, 2) * datum.c2_lon + pow(datum.t, 3) * datum.end_lon",
          "as": "route_lon"
        },
        {
          "calculate": "pow(1 - datum.t, 3) * datum.start_lat + 3 * pow(1 - datum.t, 2) * datum.t * datum.c1_lat + 3 * (1 - datum.t) * pow(datum.t, 2) * datum.c2_lat + pow(datum.t, 3) * datum.latitude",
          "as": "route_lat"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "basis",
        "strokeCap": "round",
        "opacity": 0.9,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "route_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "route_lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "destination_market",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative",
          "sort": "ascending"
        },
        "color": {
          "field": "evidence_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "edition",
              "rights",
              "both"
            ],
            "range": [
              "#147F79",
              "#6554A4",
              "#D18A32"
            ]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "evidence_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "edition",
              "rights",
              "both"
            ],
            "range": [
              [],
              [
                6,
                3
              ],
              [
                2,
                2
              ]
            ]
          },
          "legend": null
        },
        "strokeWidth": {
          "field": "title_count",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              4
            ],
            "range": [
              1.5,
              6
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "destination_market",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "title_count",
            "type": "quantitative",
            "title": "Selected award-winning books with evidence"
          },
          {
            "field": "evidence_type",
            "type": "nominal",
            "title": "Evidence"
          }
        ]
      }
