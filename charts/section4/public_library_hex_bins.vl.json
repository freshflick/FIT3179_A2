{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Historical 2016–2018 Australian public lending library locations in 115 km radius equal-area hexagons, with documented office cities of the ten most represented 2024–2026 PMLA publishers as reference points.",
  "width": "container",
  "height": 430,
  "background": "#ffffff",
  "projection": {"type": "azimuthalEqualArea", "rotate": [-134, 25]},
  "params": [
    {"name": "minimumSites", "value": 1, "bind": {"input": "range", "min": 1, "max": 50, "step": 1, "name": "Minimum libraries per cell: "}}
  ],
  "layer": [
    {
      "data": {"url": "data/abs_states_2021.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#edf2f2", "stroke": "#b8cbd0", "strokeWidth": 0.9}
    },
    {
      "data": {"url": "data/public_library_hex_bins_2018.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {"calculate": "datum.properties.libraries", "as": "libraries"},
        {"filter": "datum.libraries >= minimumSites"}
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.65, "opacity": 0.98},
      "encoding": {
        "color": {
          "field": "libraries", "type": "quantitative", "title": "Public libraries per bin",
          "scale": {"type": "threshold", "domain": [2, 5, 15, 50], "range": ["#edf4e7", "#bfdcb9", "#82bd91", "#3d9775", "#176552"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "labelExpr": "datum.label == '≥50' ? '50+' : datum.label"}
        },
        "tooltip": [
          {"field": "libraries", "type": "quantitative", "title": "Recorded public libraries"}
        ]
      }
    },
    {
      "data": {"url": "data/publisher_office_locations_top10.csv"},
      "aggregate": [{"op": "count", "as": "publisher_count"}],
      "groupby": ["map_city", "longitude", "latitude"],
      "mark": {"type": "circle", "fill": "#be7330", "stroke": "#ffffff", "strokeWidth": 1.5, "size": 105},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "tooltip": [
          {"field": "map_city", "type": "nominal", "title": "Top-ten publisher office metro"},
          {"field": "publisher_count", "type": "quantitative", "title": "Publishers mapped here"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}, "legend": {"labelFont": "Arial", "titleFont": "Arial"}}
}
