{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A true equal-area hexagonal bin map of listed PMLA books associated with the selected offices of the ten most represented publishers. Bins are regular cells of radius 170 km in an Australian-centred Lambert azimuthal equal-area projection.",
  "width": "container",
  "height": 405,
  "background": "#ffffff",
  "projection": {"type": "azimuthalEqualArea", "rotate": [-134, 25]},
  "params": [
    {"name": "selectedYear", "value": 2024, "bind": {"input": "range", "min": 2024, "max": 2026, "step": 1, "name": "Award year: "}}
  ],
  "layer": [
    {
      "data": {"url": "data/abs_states_2021.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#f4f7f6", "stroke": "#cad8dc", "strokeWidth": 0.8}
    },
    {
      "data": {"url": "data/publisher_office_hex_year.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {"calculate": "selectedYear == 2024 ? datum.properties.y2024 : selectedYear == 2025 ? datum.properties.y2025 : datum.properties.y2026", "as": "books"},
        {"calculate": "datum.properties.office_metros || 'No mapped office'", "as": "office_label"}
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2, "opacity": 0.96},
      "encoding": {
        "color": {
          "condition": {"test": "datum.books == 0", "value": "#e6eceb"},
          "field": "books", "type": "quantitative", "title": "Listed books",
          "scale": {"domain": [0, 15], "range": ["#cbdfe6", "#0d5b73"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 210, "tickCount": 4}
        },
        "tooltip": [
          {"field": "office_label", "type": "nominal", "title": "Office metro"},
          {"field": "books", "type": "quantitative", "title": "Listed books in bin"},
          {"field": "properties.hex_id", "type": "nominal", "title": "Grid cell"}
        ]
      }
    },
    {
      "data": {"url": "data/publisher_office_hex_year.geojson", "format": {"type": "json", "property": "features"}},
      "transform": [
        {"calculate": "selectedYear == 2024 ? datum.properties.y2024 : selectedYear == 2025 ? datum.properties.y2025 : datum.properties.y2026", "as": "books"},
        {"filter": "datum.books > 0"},
        {"calculate": "datum.properties.office_metros + ' · ' + datum.books", "as": "label"}
      ],
      "mark": {"type": "text", "font": "Arial", "fontSize": 12, "fontWeight": "bold", "dy": -22, "color": "#233441"},
      "encoding": {
        "longitude": {"field": "properties.centre_lon", "type": "quantitative"},
        "latitude": {"field": "properties.centre_lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "legend": {"labelFont": "Arial", "titleFont": "Arial"}}
}
