{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Equal-area bins show the number of Prime Minister’s Literary Awards books associated with documented publisher contacts across Sydney and Melbourne, 2022\u20132026.",
  "spacing": 16,
  "params": [
    {
      "name": "sydney_zoom",
      "value": 1
    },
    {
      "name": "sydney_pan_x",
      "value": 0
    },
    {
      "name": "sydney_pan_y",
      "value": 0
    },
    {
      "name": "melbourne_zoom",
      "value": 1
    },
    {
      "name": "melbourne_pan_x",
      "value": 0
    },
    {
      "name": "melbourne_pan_y",
      "value": 0
    }
  ],
  "data": {
    "url": "data/pmla_publisher_contact_hex_bins.geojson?v=4",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.metro_areas",
      "as": "metro"
    },
    {
      "calculate": "datum.properties.publishers",
      "as": "publishers"
    },
    {
      "calculate": "datum.properties.listed_books",
      "as": "listed_books"
    },
    {
      "calculate": "datum.properties.winning_books",
      "as": "winning_books"
    }
  ],
  "hconcat": [
    {
      "name": "sydney",
      "width": 500,
      "height": 238,
      "title": {
        "text": "Sydney",
        "anchor": "start",
        "fontSize": 15,
        "fontWeight": "bold",
        "offset": 4,
        "color": "#173B69"
      },
      "projection": {
        "type": "mercator",
        "center": [
          151.02,
          -33.845
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "MultiPoint",
            "coordinates": [
              [
                150.65,
                -34.12
              ],
              [
                151.39,
                -33.57
              ]
            ]
          }
        },
        "extent": {
          "expr": "[[500 / 2 + sydney_pan_x - (500 - 20) * sydney_zoom / 2, height / 2 + sydney_pan_y - (height - 20) * sydney_zoom / 2], [500 / 2 + sydney_pan_x + (500 - 20) * sydney_zoom / 2, height / 2 + sydney_pan_y + (height - 20) * sydney_zoom / 2]]"
        },
        "clipExtent": {
          "expr": "[[0, 0], [500, height]]"
        }
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EAF3F8",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/abs_sydney_suburbs_2021.geojson?v=3",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#F4F3EF",
            "stroke": "#92A6AE",
            "strokeWidth": 0.45,
            "clip": true
          }
        },
        {
          "data": {
            "graticule": {
              "step": [
                0.2,
                0.2
              ],
              "extent": [
                [
                  149.65,
                  -35.12
                ],
                [
                  152.39,
                  -32.57
                ]
              ]
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": null,
            "stroke": "#B9D1DE",
            "strokeWidth": 0.4,
            "opacity": 0.35,
            "clip": true
          }
        },
        {
          "transform": [
            {
              "filter": "datum.metro === 'Sydney'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 1,
            "opacity": 0.94,
            "clip": true
          },
          "encoding": {
            "color": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Award books in one area",
              "scale": {
                "domain": [
                  1,
                  34
                ],
                "range": [
                  "#DCEDE4",
                  "#0F6652"
                ],
                "clamp": true
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "metro",
                "type": "nominal",
                "title": "Contact metro"
              },
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Distinct publishers"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {
                "field": "winning_books",
                "type": "quantitative",
                "title": "Winners"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "melbourne",
      "width": 500,
      "height": 238,
      "title": {
        "text": "Melbourne",
        "anchor": "start",
        "fontSize": 15,
        "fontWeight": "bold",
        "offset": 4,
        "color": "#8C6D00"
      },
      "projection": {
        "type": "mercator",
        "center": [
          145.07,
          -37.88
        ],
        "fit": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "MultiPoint",
            "coordinates": [
              [
                144.57,
                -38.21
              ],
              [
                145.57,
                -37.55
              ]
            ]
          }
        },
        "extent": {
          "expr": "[[500 / 2 + melbourne_pan_x - (500 - 20) * melbourne_zoom / 2, height / 2 + melbourne_pan_y - (height - 20) * melbourne_zoom / 2], [500 / 2 + melbourne_pan_x + (500 - 20) * melbourne_zoom / 2, height / 2 + melbourne_pan_y + (height - 20) * melbourne_zoom / 2]]"
        },
        "clipExtent": {
          "expr": "[[0, 0], [500, height]]"
        }
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#EAF3F8",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/abs_melbourne_suburbs_2021.geojson?v=3",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#F4F3EF",
            "stroke": "#92A6AE",
            "strokeWidth": 0.45,
            "clip": true
          }
        },
        {
          "data": {
            "graticule": {
              "step": [
                0.25,
                0.25
              ],
              "extent": [
                [
                  143.57,
                  -39.21
                ],
                [
                  146.57,
                  -36.55
                ]
              ]
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": null,
            "stroke": "#B9D1DE",
            "strokeWidth": 0.4,
            "opacity": 0.35,
            "clip": true
          }
        },
        {
          "transform": [
            {
              "filter": "datum.metro === 'Melbourne'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 1,
            "opacity": 0.94,
            "clip": true
          },
          "encoding": {
            "color": {
              "field": "listed_books",
              "type": "quantitative",
              "title": "Award books in one area",
              "scale": {
                "domain": [
                  1,
                  34
                ],
                "range": [
                  "#DCEDE4",
                  "#0F6652"
                ],
                "clamp": true
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "metro",
                "type": "nominal",
                "title": "Contact metro"
              },
              {
                "field": "publishers",
                "type": "quantitative",
                "title": "Distinct publishers"
              },
              {
                "field": "listed_books",
                "type": "quantitative",
                "title": "Listed books"
              },
              {
                "field": "winning_books",
                "type": "quantitative",
                "title": "Winners"
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    },
    "legend": {
      "color": "shared"
    }
  },
  "config": {
    "background": "white",
    "font": "Arial",
    "view": {
      "stroke": "#C7D6DE",
      "strokeWidth": 0.7
    },
    "title": {
      "font": "Georgia",
      "subtitleFont": "Arial"
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "labelFontSize": 12,
      "labelColor": "#202124",
      "titleColor": "#202124",
      "offset": 8,
      "padding": 0
    }
  }
}
