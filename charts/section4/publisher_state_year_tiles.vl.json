{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Schematic state tile map of real PMLA listed-book counts associated with the documented offices of the top ten publishers, filtered by award year.",
  "width": "container",
  "height": 405,
  "background": "#ffffff",
  "data": {"url": "data/publisher_office_state_year.csv"},
  "params": [
    {"name": "selectedYear", "value": 2024, "bind": {"input": "range", "min": 2024, "max": 2026, "step": 1, "name": "Award year: "}}
  ],
  "transform": [{"filter": "toNumber(datum.year) == selectedYear"}],
  "encoding": {
    "x": {"field": "tile_x", "type": "ordinal", "axis": null, "scale": {"paddingInner": 0.09, "paddingOuter": 0.04}},
    "y": {"field": "tile_y", "type": "ordinal", "axis": null, "scale": {"paddingInner": 0.09, "paddingOuter": 0.04}}
  },
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 8, "stroke": "#ffffff", "strokeWidth": 2},
      "encoding": {
        "color": {
          "condition": {"test": "datum.listed_books == 0", "value": "#e8eceb"},
          "field": "listed_books", "type": "quantitative", "title": "Listed books",
          "scale": {"domain": [0, 15], "range": ["#d5e9ef", "#105a73"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 210, "tickCount": 4}
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Award year"},
          {"field": "state_name", "type": "nominal", "title": "Publisher office state"},
          {"field": "listed_books", "type": "quantitative", "title": "Listed books"}
        ]
      }
    },
    {
      "mark": {"type": "text", "font": "Arial", "fontWeight": "bold", "fontSize": 16},
      "encoding": {
        "text": {"field": "state", "type": "nominal"},
        "color": {"condition": {"test": "datum.listed_books >= 7", "value": "#ffffff"}, "value": "#233441"}
      }
    },
    {
      "mark": {"type": "text", "font": "Arial", "fontSize": 13, "dy": 24},
      "encoding": {
        "text": {"field": "listed_books", "type": "quantitative", "format": ".0f"},
        "color": {"condition": {"test": "datum.listed_books >= 7", "value": "#ffffff"}, "value": "#233441"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "legend": {"labelFont": "Arial", "titleFont": "Arial"}}
}
