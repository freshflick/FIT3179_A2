{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Publisher-attributed shortlist and winning records for the Prime Minister’s Literary Awards, 2022–2026.",
  "data": { "url": "data/pmla_2022_2026.csv" },
  "width": "container",
  "height": 390,
  "autosize": { "type": "fit-x", "contains": "padding", "resize": true },
  "transform": [
    {
      "aggregate": [{ "op": "count", "as": "books" }],
      "groupby": ["publisher_key"]
    },
    { "filter": "datum.books >= 3" },
    {
      "window": [{ "op": "row_number", "as": "publisher_rank" }],
      "sort": [
        { "field": "books", "order": "descending" },
        { "field": "publisher_key", "order": "ascending" }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "books",
      "type": "quantitative",
      "title": "Books on the award list",
      "scale": { "domain": [0, 25] },
      "axis": {
        "values": [0, 5, 10, 15, 20, 25],
        "grid": true,
        "gridColor": "#e6ecee",
        "tickSize": 0
      }
    },
    "y": {
      "field": "publisher_key",
      "type": "nominal",
      "title": null,
      "sort": { "field": "publisher_rank", "op": "min", "order": "ascending" },
      "axis": { "labelLimit": 350, "tickSize": 0, "domain": false }
    },
    "tooltip": [
      { "field": "publisher_key", "type": "nominal", "title": "Publisher" },
      { "field": "books", "type": "quantitative", "title": "Books" }
    ]
  },
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusEnd": 2 },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.publisher_key === 'Allen & Unwin'",
            "value": "#b6813e"
          },
          "value": "#79a1ad"
        }
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 6, "fontWeight": "bold" },
      "encoding": {
        "text": { "field": "books", "type": "quantitative", "format": "d" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#3c4c56",
      "titleColor": "#3c4c56",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "text": { "font": "Arial", "color": "#233441", "fontSize": 12 }
  }
}
