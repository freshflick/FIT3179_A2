{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Award category appearances for publishers with at least three publisher-attributed records, 2022–2026.",
  "data": { "url": "data/pmla_2022_2026.csv" },
  "width": "container",
  "height": 311,
  "transform": [
    {
      "joinaggregate": [{ "op": "count", "as": "publisher_total" }],
      "groupby": ["publisher_key"]
    },
    { "filter": "datum.publisher_total >= 3" },
    {
      "aggregate": [{ "op": "count", "as": "books" }],
      "groupby": ["publisher_key", "category"]
    },
    {
      "impute": "books",
      "key": "category",
      "groupby": ["publisher_key"],
      "keyvals": [
        "Fiction",
        "Non-fiction",
        "Australian history",
        "Poetry",
        "Young adult literature",
        "Children’s literature"
      ],
      "value": 0
    },
    {
      "joinaggregate": [
        { "op": "sum", "field": "books", "as": "publisher_total_for_sort" }
      ],
      "groupby": ["publisher_key"]
    },
    {
      "window": [{ "op": "dense_rank", "as": "publisher_rank" }],
      "sort": [
        { "field": "publisher_total_for_sort", "order": "descending" },
        { "field": "publisher_key", "order": "ascending" }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": [
        "Fiction",
        "Non-fiction",
        "Australian history",
        "Poetry",
        "Young adult literature",
        "Children’s literature"
      ],
      "axis": {
        "labelAngle": -40,
        "labelLimit": 120,
        "tickSize": 0,
        "domain": false,
        "labelExpr": "datum.label == 'Australian history' ? 'History' : datum.label == 'Young adult literature' ? 'Young adult' : datum.label == 'Children’s literature' ? 'Children’s' : datum.label"
      }
    },
    "y": {
      "field": "publisher_key",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "publisher_rank",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "labelLimit": 205,
        "tickSize": 0,
        "domain": false
      }
    },
    "tooltip": [
      { "field": "publisher_key", "type": "nominal", "title": "Publisher" },
      { "field": "category", "type": "nominal", "title": "Category" },
      { "field": "books", "type": "quantitative", "title": "Books" }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "books",
          "type": "quantitative",
          "title": "Books on list",
          "scale": {
            "domain": [0, 8],
            "range": ["#fff1ef", "#a53e59"]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 220,
            "gradientThickness": 10
          }
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#1A1A1A",
      "labelFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#1A1A1A",
      "titleColor": "#1A1A1A",
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  }
}
