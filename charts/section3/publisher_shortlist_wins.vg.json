{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compare publisher-attributed Prime Minister’s Literary Awards shortlist appearances with wins, 2022–2026. Highlights and overlap offsets are calculated from the data.",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "layer": [
    {
      "data": {
        "url": "data/pmla_2022_2026.csv"
      },
      "transform": [
        {
          "calculate": "datum.outcome === 'winner' ? 1 : 0",
          "as": "won"
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "publisher_appearances"
            }
          ],
          "groupby": [
            "publisher_key"
          ]
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "publisher_appearances",
              "as": "most_appearances"
            },
            {
              "op": "count",
              "as": "total_books"
            },
            {
              "op": "sum",
              "field": "won",
              "as": "total_wins"
            }
          ]
        },
        {
          "calculate": "0",
          "as": "start"
        },
        {
          "calculate": "datum.most_appearances + 2",
          "as": "end"
        },
        {
          "fold": [
            "start",
            "end"
          ],
          "as": [
            "end_point",
            "appearances"
          ]
        },
        {
          "calculate": "datum.appearances * datum.total_wins / datum.total_books",
          "as": "wins"
        }
      ],
      "mark": {
        "type": "line",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1.5,
        "color": "#b8c7cc"
      },
      "encoding": {
        "x": {
          "field": "appearances",
          "type": "quantitative",
          "title": "Books on the award lists",
          "scale": {
            "zero": true
          },
          "axis": {
            "format": "d",
            "tickMinStep": 1,
            "grid": true,
            "gridColor": "#e6ecee",
            "tickSize": 0
          }
        },
        "y": {
          "field": "wins",
          "type": "quantitative",
          "title": "Winning books",
          "scale": {
            "zero": true
          },
          "axis": {
            "format": "d",
            "tickMinStep": 1,
            "grid": true,
            "gridColor": "#e6ecee",
            "tickSize": 0
          }
        }
      }
    },
    {
      "data": {
        "url": "data/pmla_2022_2026.csv"
      },
      "transform": [
        {
          "calculate": "datum.outcome === 'winner' ? 1 : 0",
          "as": "won"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "appearances"
            },
            {
              "op": "sum",
              "field": "won",
              "as": "wins"
            }
          ],
          "groupby": [
            "publisher_key"
          ]
        },
        {
          "filter": "datum.appearances >= 3"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "appearances",
              "as": "most_appearances"
            },
            {
              "op": "max",
              "field": "wins",
              "as": "most_wins"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "wins",
              "as": "fewest_wins_at_count"
            },
            {
              "op": "max",
              "field": "wins",
              "as": "most_wins_at_count"
            }
          ],
          "groupby": [
            "appearances"
          ]
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "publisher_key",
              "as": "lower_win_peer"
            }
          ],
          "groupby": [
            "appearances"
          ],
          "sort": [
            {
              "field": "wins",
              "order": "ascending"
            },
            {
              "field": "publisher_key",
              "order": "ascending"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "calculate": "datum.most_wins_at_count > datum.fewest_wins_at_count && datum.wins === datum.most_wins_at_count ? datum.wins : 0",
          "as": "contrast_wins"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "contrast_wins",
              "as": "best_contrast_wins"
            }
          ]
        },
        {
          "calculate": "datum.appearances === datum.most_appearances ? 'Most listed' : datum.wins === datum.most_wins ? 'Ties most wins' : datum.contrast_wins > 0 && datum.contrast_wins === datum.best_contrast_wins ? 'Same count, more wins' : 'Other'",
          "as": "highlight_role"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "duplicate_index"
            }
          ],
          "groupby": [
            "appearances",
            "wins"
          ],
          "sort": [
            {
              "field": "publisher_key",
              "order": "ascending"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "duplicate_count"
            }
          ],
          "groupby": [
            "appearances",
            "wins"
          ]
        },
        {
          "calculate": "datum.appearances + (datum.duplicate_index - (datum.duplicate_count + 1) / 2) * 0.24",
          "as": "display_appearances"
        },
        {
          "calculate": "datum.most_wins * 0.57",
          "as": "box_top"
        },
        {
          "calculate": "datum.most_wins * 0.20",
          "as": "box_bottom"
        }
      ],
      "encoding": {
        "x": {
          "field": "display_appearances",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickMinStep": 1
          }
        },
        "y": {
          "field": "wins",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickMinStep": 1
          }
        },
        "tooltip": [
          {
            "field": "publisher_key",
            "type": "nominal",
            "title": "Publisher"
          },
          {
            "field": "appearances",
            "type": "quantitative",
            "title": "Books on lists",
            "format": "d"
          },
          {
            "field": "wins",
            "type": "quantitative",
            "title": "Winners",
            "format": "d"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 185,
            "opacity": 0.93,
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "color": {
              "condition": [
                {
                  "test": "datum.highlight_role === 'Most listed' || datum.highlight_role === 'Ties most wins'",
                  "value": "#40556B"
                },
                {
                  "test": "datum.highlight_role === 'Same count, more wins'",
                  "value": "#2E7D4B"
                }
              ],
              "value": "#AEB9C0"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.highlight_role === 'Most listed'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -11,
            "dy": -12,
            "fontWeight": "bold",
            "fontSize": 12,
            "color": "#233441"
          },
          "encoding": {
            "text": {
              "field": "publisher_key"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.highlight_role === 'Ties most wins'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 11,
            "dy": -12,
            "fontWeight": "bold",
            "fontSize": 12,
            "color": "#233441"
          },
          "encoding": {
            "text": {
              "field": "publisher_key"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.highlight_role === 'Same count, more wins'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -11,
            "dy": -14,
            "fontWeight": "bold",
            "fontSize": 12,
            "color": "#2E7D4B"
          },
          "encoding": {
            "text": {
              "field": "publisher_key"
            }
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#1A1A1A",
      "titleColor": "#1A1A1A",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}