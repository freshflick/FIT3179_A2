  "scales": [
    {
      "name": "stageX",
      "type": "ordinal",
      "domain": [
        "longlist",
        "shortlist",
        "outcome"
      ],
      "range": [
        {
          "signal": "width < 600 ? 32 : 68"
        },
        {
          "signal": "width * 0.48"
        },
        {
          "signal": "width - (width < 600 ? 32 : 195)"
        }
      ]
    },
    {
      "name": "booksY",
      "type": "linear",
      "domain": [
        0,
        60
      ],
      "range": [
        68,
        388
      ],
      "zero": true
    },
    {
      "name": "genreColour",
      "type": "ordinal",
      "domain": [
        "Fiction",
        "Non-fiction & memoir",
        "Poetry",
        "Graphic novel"
      ],
      "range": [
        "#A24FA6",
        "#2E93A7",
        "#C0454A",
        "#8C9A3A"
      ]
    }
  ],
  "legends": [
    {
      "fill": "genreColour",
      "orient": "bottom",
      "direction": "horizontal",
      "title": null,
      "symbolType": "square",
      "symbolSize": 115,
      "labelFont": "Arial",
      "labelFontSize": 11,
      "labelColor": "#3c4c56",
      "columns": 2,
      "offset": 10
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M' + (scale('stageX', datum.src) + nodeWidth/2) + ',' + scale('booksY', datum.sy0) + ' C' + ((scale('stageX', datum.src) + scale('stageX', datum.dst))/2) + ',' + scale('booksY', datum.sy0) + ' ' + ((scale('stageX', datum.src) + scale('stageX', datum.dst))/2) + ',' + scale('booksY', datum.ty0) + ' ' + (scale('stageX', datum.dst) - nodeWidth/2) + ',' + scale('booksY', datum.ty0) + ' L' + (scale('stageX', datum.dst) - nodeWidth/2) + ',' + scale('booksY', datum.ty1) + ' C' + ((scale('stageX', datum.src) + scale('stageX', datum.dst))/2) + ',' + scale('booksY', datum.ty1) + ' ' + ((scale('stageX', datum.src) + scale('stageX', datum.dst))/2) + ',' + scale('booksY', datum.sy1) + ' ' + (scale('stageX', datum.src) + nodeWidth/2) + ',' + scale('booksY', datum.sy1) + ' Z'"
          },
          "fill": {
            "scale": "genreColour",
            "field": "genre"
          },
          "fillOpacity": {
            "field": "opacity"
          },
          "tooltip": {
            "signal": "datum.genre + ': ' + datum.count + ' books ' + datum.phase"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.88
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('stageX', datum.stage) - nodeWidth/2"
          },
          "x2": {
            "signal": "scale('stageX', datum.stage) + nodeWidth/2"
          },
          "y": {
            "scale": "booksY",
            "field": "y0"
          },
          "y2": {
            "scale": "booksY",
            "field": "y1"
          },
          "fill": {
            "scale": "genreColour",
            "field": "genre"
          },
          "fillOpacity": {
            "field": "opacity"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "datum.genre + ': ' + datum.count + ' books ' + datum.phase"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "signal": "scale('stageX', 'shortlist') + 14"
          },
          "x2": {
            "signal": "scale('stageX', 'outcome') - 18"
          },
          "y": {
            "scale": "booksY",
            "value": 18
          },
          "stroke": {
            "value": "#d7e1e4"
          },
          "strokeDash": {
            "value": [
              3,
              4
            ]
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "stageLabels"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "stageX",
            "field": "stage"
          },
          "y": {
            "value": 22
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "heading"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#233441"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "outcomeLabels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('stageX', 'outcome') + 22"
          },
          "y": {
            "scale": "booksY",
            "field": "y"
          },
          "text": {
            "field": "label"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "field": "weight"
          },
          "fill": {
            "value": "#3c4c56"
          },
          "opacity": {
            "signal": "width >= 620 ? 1 : 0"
          }
        }
      }
    }
  ]
}
